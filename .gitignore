# Editable-install artefacts
*.egg-info/
build/
dist/

# Build artifacts
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Fetched third-party data (~790 MB on disk) - reproduce with
# scripts/fetch_real_models.py and scripts/fetch_nepali_models.py
corpus-real/
corpus-nepali/

# Per-artifact scratch from the evaluations; the summaries are committed
reports/eval-runs*/
reports/repair-runs/
reports/escape-run/

# Video frame intermediates; the encoded video and transcript are committed
reports/video/frames/

# NEVER commit key material. A leaked signing key makes every receipt worthless.
# Curated evidence is tracked (runs/probe, runs/benign - the README verifies against
# runs/probe). Everything the tooling regenerates is scratch, including the video build's
# own captures, so a rebuild cannot silently rewrite committed evidence.
runs/demo/
runs/demo-escalated/
runs/it2/

# The baseline measurement's scratch container workdir (the measured floor itself is tracked)
baselines/run/

# Private keys are never committed. PUBLIC keys must be, or nobody can verify a receipt:
# the README's recipe uses runs/probe/keys/quarantine.pub.pem, and ignoring it made the
# documented verification path impossible to follow from a fresh clone.
**/*.pem
!**/*.pub.pem

safety_results.json
